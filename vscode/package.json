{
  "name": "ntm-vscode",
  "displayName": "NTM Integration",
  "description": "Integration for Named Tmux Manager (NTM)",
  "version": "1.38.0",
  "publisher": "dicklesworthstone",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dicklesworthstone/ntm"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:ntmSessions",
    "onCommand:ntm.spawn",
    "onCommand:ntm.spawnEnsemble",
    "onCommand:ntm.triageAttention",
    "onCommand:ntm.openWebCockpit",
    "onCommand:ntm.showStatus",
    "onCommand:ntm.openPalette"
  ],
  "main": "./out/extension.js",
  "vsce": {
    "dependencies": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ntm",
          "title": "NTM",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "ntm": [
        {
          "id": "ntmSessions",
          "name": "Sessions",
          "contextualTitle": "NTM Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "ntm.spawn",
        "title": "NTM: Spawn Agents for Project"
      },
      {
        "command": "ntm.showStatus",
        "title": "NTM: Show Session Status"
      },
      {
        "command": "ntm.sendPrompt",
        "title": "NTM: Send Prompt to Agent"
      },
      {
        "command": "ntm.sendSelection",
        "title": "NTM: Send Selection to Agent"
      },
      {
        "command": "ntm.sendCurrentFile",
        "title": "NTM: Send Current File to Agent"
      },
      {
        "command": "ntm.openTerminal",
        "title": "NTM: Open Terminal (Attach)"
      },
      {
        "command": "ntm.viewSession",
        "title": "NTM: View Session Panes",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "ntm.zoomPane",
        "title": "NTM: Zoom Agent Pane",
        "icon": "$(screen-full)"
      },
      {
        "command": "ntm.terminalDashboard",
        "title": "NTM: Open TUI Dashboard in Terminal"
      },
      {
        "command": "ntm.spawnEnsemble",
        "title": "NTM: Spawn Reasoning Ensemble",
        "icon": "$(sparkle)"
      },
      {
        "command": "ntm.triageAttention",
        "title": "NTM: Triage Attention Feed",
        "icon": "$(bell)"
      },
      {
        "command": "ntm.openWebCockpit",
        "title": "NTM: Open Web Cockpit (ntm web)",
        "icon": "$(globe)"
      },
      {
        "command": "ntm.openPalette",
        "title": "NTM: Open Command Palette"
      },
      {
        "command": "ntm.dashboard",
        "title": "NTM: Open Dashboard"
      },
      {
        "command": "ntm.refreshSessions",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "ntm.attachSession",
        "title": "Attach to Session",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ntm.refreshSessions",
          "when": "view == ntmSessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ntm.attachSession",
          "when": "view == ntmSessions && viewItem == session",
          "group": "inline"
        },
        {
          "command": "ntm.viewSession",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.zoomPane",
          "when": "view == ntmSessions && viewItem == agent",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "NTM",
      "properties": {
        "ntm.binaryPath": {
          "type": "string",
          "default": "ntm",
          "description": "Path to ntm executable"
        },
        "ntm.webPort": {
          "type": "number",
          "default": 7337,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port for the NTM Web Cockpit HTTP server (ntm web --port)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/extension.test.js"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^6.0.3"
  }
}
