{
  "name": "ntm-vscode",
  "displayName": "NTM Integration",
  "description": "Integration for Named Tmux Manager (NTM)",
  "version": "1.40.0",
  "publisher": "dicklesworthstone",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dicklesworthstone/ntm"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:ntmSessions",
    "onCommand:ntm.spawn",
    "onCommand:ntm.showStatus",
    "onCommand:ntm.sendPrompt",
    "onCommand:ntm.sendSelection",
    "onCommand:ntm.sendCurrentFile",
    "onCommand:ntm.openTerminal",
    "onCommand:ntm.viewSession",
    "onCommand:ntm.zoomPane",
    "onCommand:ntm.terminalDashboard",
    "onCommand:ntm.spawnEnsemble",
    "onCommand:ntm.synthesizeEnsemble",
    "onCommand:ntm.triageAttention",
    "onCommand:ntm.triageIncidents",
    "onCommand:ntm.handoffSession",
    "onCommand:ntm.showAnalytics",
    "onCommand:ntm.showAudit",
    "onCommand:ntm.generateSupportBundle",
    "onCommand:ntm.runDoctor",
    "onCommand:ntm.preflightPrompt",
    "onCommand:ntm.assignWork",
    "onCommand:ntm.scaleSession",
    "onCommand:ntm.rebalanceSession",
    "onCommand:ntm.reviewQueue",
    "onCommand:ntm.showSummary",
    "onCommand:ntm.adoptSession",
    "onCommand:ntm.previewRedaction",
    "onCommand:ntm.showContext",
    "onCommand:ntm.savedSessions",
    "onCommand:ntm.showAgentMapping",
    "onCommand:ntm.showWorkflows",
    "onCommand:ntm.grepPanes",
    "onCommand:ntm.extractCodeBlocks",
    "onCommand:ntm.validateConfig",
    "onCommand:ntm.showLocalModels",
    "onCommand:ntm.openWebCockpit",
    "onCommand:ntm.showBackpressure",
    "onCommand:ntm.manageWorktrees",
    "onCommand:ntm.openPalette",
    "onCommand:ntm.dashboard",
    "onCommand:ntm.refreshSessions",
    "onCommand:ntm.attachSession"
  ],
  "main": "./out/extension.js",
  "vsce": {
    "dependencies": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ntm",
          "title": "NTM",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "ntm": [
        {
          "id": "ntmSessions",
          "name": "Sessions",
          "contextualTitle": "NTM Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "ntm.spawn",
        "title": "NTM: Spawn Agents for Project"
      },
      {
        "command": "ntm.showStatus",
        "title": "NTM: Show Session Status"
      },
      {
        "command": "ntm.sendPrompt",
        "title": "NTM: Send Prompt to Agent"
      },
      {
        "command": "ntm.sendSelection",
        "title": "NTM: Send Selection to Agent"
      },
      {
        "command": "ntm.sendCurrentFile",
        "title": "NTM: Send Current File to Agent"
      },
      {
        "command": "ntm.openTerminal",
        "title": "NTM: Open Terminal (Attach)"
      },
      {
        "command": "ntm.viewSession",
        "title": "NTM: View Session Panes",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "ntm.zoomPane",
        "title": "NTM: Zoom Agent Pane",
        "icon": "$(screen-full)"
      },
      {
        "command": "ntm.terminalDashboard",
        "title": "NTM: Open TUI Dashboard in Terminal"
      },
      {
        "command": "ntm.spawnEnsemble",
        "title": "NTM: Spawn Reasoning Ensemble",
        "icon": "$(sparkle)"
      },
      {
        "command": "ntm.synthesizeEnsemble",
        "title": "NTM: Synthesize Reasoning Ensemble",
        "icon": "$(combine)"
      },
      {
        "command": "ntm.triageAttention",
        "title": "NTM: Triage Attention Feed",
        "icon": "$(bell)"
      },
      {
        "command": "ntm.triageIncidents",
        "title": "NTM: Triage Operator Incidents",
        "icon": "$(flame)"
      },
      {
        "command": "ntm.handoffSession",
        "title": "NTM: Session Handoff (Inspect / Create)",
        "icon": "$(note)"
      },
      {
        "command": "ntm.showAnalytics",
        "title": "NTM: Show Swarm & Harness Analytics",
        "icon": "$(graph)"
      },
      {
        "command": "ntm.showAudit",
        "title": "NTM: Inspect & Verify Audit Logs",
        "icon": "$(shield)"
      },
      {
        "command": "ntm.generateSupportBundle",
        "title": "NTM: Generate Redacted Support Bundle",
        "icon": "$(package)"
      },
      {
        "command": "ntm.runDoctor",
        "title": "NTM: Run Ecosystem Doctor",
        "icon": "$(stethoscope)"
      },
      {
        "command": "ntm.preflightPrompt",
        "title": "NTM: Preflight Prompt / Selection",
        "icon": "$(verified)"
      },
      {
        "command": "ntm.assignWork",
        "title": "NTM: Plan & Assign Beads Work",
        "icon": "$(tasklist)"
      },
      {
        "command": "ntm.scaleSession",
        "title": "NTM: Scale Session Agents (12 Harnesses)",
        "icon": "$(layers)"
      },
      {
        "command": "ntm.rebalanceSession",
        "title": "NTM: Rebalance Session Workload",
        "icon": "$(sync)"
      },
      {
        "command": "ntm.reviewQueue",
        "title": "NTM: Peer Review Queue",
        "icon": "$(checklist)"
      },
      {
        "command": "ntm.showSummary",
        "title": "NTM: Show Session Activity Summary",
        "icon": "$(output)"
      },
      {
        "command": "ntm.adoptSession",
        "title": "NTM: Adopt External Tmux Session (13 Types)",
        "icon": "$(plug)"
      },
      {
        "command": "ntm.previewRedaction",
        "title": "NTM: Preview Secret & PII Redaction",
        "icon": "$(shield)"
      },
      {
        "command": "ntm.showContext",
        "title": "NTM: Show Session Context Window Usage",
        "icon": "$(dashboard)"
      },
      {
        "command": "ntm.savedSessions",
        "title": "NTM: Saved Sessions & casr Resume Readiness",
        "icon": "$(archive)"
      },
      {
        "command": "ntm.showAgentMapping",
        "title": "NTM: Show Agent Mail <-> Pane Mapping",
        "icon": "$(organization)"
      },
      {
        "command": "ntm.showWorkflows",
        "title": "NTM: Browse Workflows & Session Templates",
        "icon": "$(symbol-event)"
      },
      {
        "command": "ntm.grepPanes",
        "title": "NTM: Grep Pane Scrollback (12 Harnesses)",
        "icon": "$(search)"
      },
      {
        "command": "ntm.extractCodeBlocks",
        "title": "NTM: Extract Code Blocks from Panes",
        "icon": "$(code)"
      },
      {
        "command": "ntm.validateConfig",
        "title": "NTM: Validate Config, Policy & 12 Harnesses",
        "icon": "$(check-all)"
      },
      {
        "command": "ntm.showLocalModels",
        "title": "NTM: Plugins & Local Ollama Models",
        "icon": "$(extensions)"
      },
      {
        "command": "ntm.openWebCockpit",
        "title": "NTM: Open Web Cockpit (ntm web)",
        "icon": "$(globe)"
      },
      {
        "command": "ntm.showBackpressure",
        "title": "NTM: Show Swarm Backpressure",
        "icon": "$(pulse)"
      },
      {
        "command": "ntm.manageWorktrees",
        "title": "NTM: Manage Agent Worktrees",
        "icon": "$(git-branch)"
      },
      {
        "command": "ntm.openPalette",
        "title": "NTM: Open Command Palette"
      },
      {
        "command": "ntm.dashboard",
        "title": "NTM: Open Dashboard"
      },
      {
        "command": "ntm.refreshSessions",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "ntm.attachSession",
        "title": "Attach to Session",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ntm.refreshSessions",
          "when": "view == ntmSessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ntm.attachSession",
          "when": "view == ntmSessions && viewItem == session",
          "group": "inline"
        },
        {
          "command": "ntm.viewSession",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.handoffSession",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.assignWork",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.scaleSession",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.rebalanceSession",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.reviewQueue",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.showSummary",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.showContext",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.adoptSession",
          "when": "view == ntmSessions && viewItem == session",
          "group": "navigation"
        },
        {
          "command": "ntm.zoomPane",
          "when": "view == ntmSessions && viewItem == agent",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "NTM",
      "properties": {
        "ntm.binaryPath": {
          "type": "string",
          "default": "ntm",
          "description": "Path to ntm executable"
        },
        "ntm.webPort": {
          "type": "number",
          "default": 7337,
          "minimum": 1,
          "maximum": 65535,
          "description": "Port for the NTM Web Cockpit HTTP server (ntm web --port)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/extension.test.js"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^6.0.3"
  }
}
