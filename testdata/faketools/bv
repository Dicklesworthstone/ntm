#!/bin/bash
# Fake bv tool for testing
# Supports MODE environment variable:
#   normal (default)      - version 0.31.0, every robot mode answers
#   timeout               - hangs (killed by the adapter timeout)
#   error                 - every command exits 1 with plain-text stderr
#   schema_drift          - returns JSON with an unexpected schema
#   robot_error           - version answers, robot modes exit 1 with stderr
#   old_version_answers   - version 0.15.0 (below gate), robot modes answer
#   old_version_refuses   - version 0.15.0 (below gate), robot modes exit 1
#   zero_counts           - robot-history returns well-formed zero counts
#   malformed             - robot modes return non-JSON text
#   no_sprint             - robot-burndown exits 1 with "No active sprint found"

MODE="${FAKE_TOOL_MODE:-normal}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FIXTURES_DIR="$SCRIPT_DIR/../fixtures"

case "$MODE" in
    timeout)
        # Use exec to replace bash with sleep so the process can be killed properly
        # Without exec, sleep becomes a child process that survives when bash is killed
        exec sleep 3600
        ;;
    error)
        echo "bv: simulated error" >&2
        exit 1
        ;;
    schema_drift)
        # Return JSON with unexpected schema
        echo '{"unexpected_field": true, "version": "0.31.0-drift"}'
        exit 0
        ;;
esac

# Normalize: strip leading dashes so both -robot-triage and --robot-triage match
ARG="${1#-}"
ARG="${ARG#-}"

# --version reports a mode-dependent version.
case "$ARG" in
    -version|version)
        case "$MODE" in
            old_version_answers|old_version_refuses)
                echo "bv 0.15.0 (fake)"
                ;;
            *)
                echo "bv 0.31.0 (fake)"
                ;;
        esac
        exit 0
        ;;
esac

# Modes that fail every robot command with plain-text stderr (or non-JSON).
case "$MODE" in
    robot_error)
        echo "bv: robot mode failed" >&2
        exit 1
        ;;
    old_version_refuses)
        echo "bv: unknown command: $1" >&2
        exit 1
        ;;
    malformed)
        echo "this is not json"
        exit 0
        ;;
esac

# Normal mode - check arguments
case "$ARG" in
    robot-triage)
        cat "$FIXTURES_DIR/bv_triage.json" 2>/dev/null || echo '{"generated_at": "2026-01-01T00:00:00Z", "data_hash": "test", "triage": {"meta": {"version": "1.0.0"}, "quick_ref": {"open_count": 10, "actionable_count": 5}}}'
        exit 0
        ;;
    robot-triage-by-label)
        echo '{"generated_at":"2026-01-01T00:00:00Z","triage_by_label":[{"label":"backend","top_pick":{"id":"bd-1","title":"Test"}}]}'
        exit 0
        ;;
    robot-triage-by-track)
        echo '{"generated_at":"2026-01-01T00:00:00Z","triage_by_track":[{"track":"main","top_pick":{"id":"bd-1","title":"Test"}}]}'
        exit 0
        ;;
    robot-plan)
        cat "$FIXTURES_DIR/bv_plan.json" 2>/dev/null || echo '{"generated_at": "2026-01-01T00:00:00Z", "plan": {"tracks": []}}'
        exit 0
        ;;
    robot-insights)
        cat "$FIXTURES_DIR/bv_insights.json" 2>/dev/null || echo '{"generated_at": "2026-01-01T00:00:00Z", "insights": {}}'
        exit 0
        ;;
    robot-next)
        cat "$FIXTURES_DIR/bv_next.json" 2>/dev/null || echo '{"id": "test-1", "title": "Test issue", "command": "bd update test-1 --status in_progress"}'
        exit 0
        ;;
    robot-alerts)
        echo '{"alerts":[{"type":"stale","severity":"warning","message":"Stale issue","issue_id":"bd-1","labels":["backend"]}]}'
        exit 0
        ;;
    robot-graph)
        echo '{"graph":{"nodes":[],"edges":[]},"format":"json"}'
        exit 0
        ;;
    robot-history)
        if [ "$MODE" = "zero_counts" ]; then
            echo '{"stats":{"total_beads":0,"beads_with_commits":0,"total_commits":0},"histories":[],"commit_index":{}}'
        else
            echo '{"stats":{"total_beads":1,"beads_with_commits":1,"total_commits":1},"histories":[{"id":"bd-1","title":"Test","events":[]}],"commit_index":{}}'
        fi
        exit 0
        ;;
    robot-burndown)
        if [ "$MODE" = "no_sprint" ]; then
            echo "No active sprint found" >&2
            exit 1
        fi
        echo '{"sprint":"s1","progress":{"total_points":10,"completed_points":4,"percent_complete":40,"days_remaining":3},"scope_changes":[],"at_risk":[]}'
        exit 0
        ;;
    robot-forecast)
        echo '{"generated_at":"2026-02-01T00:00:00Z","data_hash":"fake","output_format":"json","version":"v0.16.0","agents":1,"forecast_count":1,"forecasts":[{"issue_id":"bd-1","estimated_minutes":60,"estimated_days":0.1,"eta_date":"2026-02-01T00:00:00Z","eta_date_low":"2026-02-01T00:00:00Z","eta_date_high":"2026-02-02T00:00:00Z","confidence":0.8,"velocity_minutes_per_day":600,"agents":1,"factors":["fake estimate"]}],"summary":{"total_minutes":60,"total_days":0.1,"avg_confidence":0.8,"earliest_eta":"2026-02-01T00:00:00Z","latest_eta":"2026-02-01T00:00:00Z"}}'
        exit 0
        ;;
    robot-suggest)
        echo '{"suggestions":[{"type":"duplicate","description":"Check duplicates","items":["bd-1"]}]}'
        exit 0
        ;;
    robot-impact)
        echo '{"generated_at":"2026-02-01T00:00:00Z","data_hash":"fake","output_format":"json","version":"v0.16.0","files":["internal/foo.go"],"risk_level":"low","risk_score":0.05,"summary":"fake impact","warnings":[],"affected_beads":[{"bead_id":"bd-1","title":"Test issue","status":"open","overlap_files":["internal/foo.go"],"overlap_count":1,"last_activity":"2026-02-01T00:00:00Z","relevance":0.9,"total_changes":1}]}'
        exit 0
        ;;
    robot-search)
        echo '{"generated_at":"2026-02-01T00:00:00Z","data_hash":"fake","query":"test query","results":[{"issue_id":"bd-1","title":"Test issue","score":0.9}]}'
        exit 0
        ;;
    robot-label-attention)
        echo '{"generated_at":"2026-02-01T00:00:00Z","data_hash":"fake","limit":5,"total_labels":1,"labels":[{"rank":1,"label":"backend","attention_score":0.7,"normalized_score":1,"reason":"fake","open_count":1,"blocked_count":0,"stale_count":0,"pagerank_sum":0.7,"velocity_factor":1}]}'
        exit 0
        ;;
    robot-label-flow)
        echo '{"flow":{"labels":["backend","frontend"],"flow_matrix":[[0,2],[0,0]],"dependencies":[{"from_label":"backend","to_label":"frontend","issue_count":2,"issue_ids":["bd-1","bd-2"]}],"bottleneck_labels":["backend"]}}'
        exit 0
        ;;
    robot-label-health)
        echo '{"generated_at":"2026-02-01T00:00:00Z","data_hash":"fake","results":{"labels":[{"label":"backend","issue_count":4,"open_count":2,"closed_count":2,"blocked_count":3,"health":50,"health_level":"warning","velocity":{"closed_last_7_days":1,"closed_last_30_days":2,"avg_days_to_close":1.2,"trend_direction":"stable","trend_percent":0,"velocity_score":0.5},"freshness":{"most_recent_update":"2026-02-01T00:00:00Z","oldest_open_issue":"2026-01-01T00:00:00Z","avg_days_since_update":2,"stale_count":1,"stale_threshold_days":14,"freshness_score":0.8}}]}}'
        exit 0
        ;;
    robot-file-beads)
        echo '{"files":[{"path":"internal/foo.go","beads":["bd-1"]}]}'
        exit 0
        ;;
    robot-file-hotspots)
        echo '{"hotspots":[{"path":"internal/foo.go","score":5}]}'
        exit 0
        ;;
    robot-file-relations)
        echo '{"relations":[{"source":"a.go","target":"b.go","weight":0.8}]}'
        exit 0
        ;;
    help|h)
        echo "bv - Beads Viewer (fake for testing)"
        echo "Usage: bv [options]"
        echo "  --version          Show version"
        echo "  --robot-triage     Get triage recommendations"
        echo "  --robot-plan       Get execution plan"
        echo "  --robot-insights   Get graph insights"
        echo "  --robot-next       Get next work item"
        exit 0
        ;;
    *)
        echo "bv: unknown command: $1" >&2
        exit 1
        ;;
esac
